# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.netwave-studio.company

# Envoi des demandes de devis via Resend (https://resend.com)
# Obligatoire en production : sans clé, le formulaire renvoie une erreur et invite à passer par WhatsApp.
# En développement, l'envoi est simulé.
RESEND_API_KEY=re_your_api_key_here

# Expéditeur. Vérifiez votre domaine dans Resend pour éviter les spams,
# l'adresse onboarding@resend.dev n'envoie qu'au propriétaire du compte.
RESEND_FROM="NetWave Studio <devis@netwave-studio.company>"

# Adresse qui reçoit les demandes
CONTACT_NOTIFICATION_EMAIL=netwave.studio.web@gmail.com

# SEO : codes de vérification (balise HTML) Google Search Console et Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
